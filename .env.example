# Database (SQLite for local dev; use a postgresql:// URL in production and switch the provider in prisma/schema.prisma)
DATABASE_URL="file:../storage/dev.db"

# Public URL of the site (used for Instagram OAuth redirect)
APP_URL="http://localhost:3000"

# Random 32+ character string. Used to encrypt stored Instagram tokens and protect the resync cron endpoint.
APP_SECRET="change-me-to-a-long-random-string"

# The account with this email becomes an admin (seed creates it with ADMIN_PASSWORD)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Optional: enables the AI fallback for unusual store sites and Instagram caption parsing
ANTHROPIC_API_KEY=""

# Optional: "Continue with Google". Create an OAuth client (Web application) in Google Cloud Console
# with the redirect URI  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Instagram API with Instagram Login (Meta developer app)
IG_APP_ID=""
IG_APP_SECRET=""
